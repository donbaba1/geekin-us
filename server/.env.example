# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# CORS: the origin(s) allowed to POST to this API. Use your real domain(s)
# in production — comma-separate if you need both geekin.ca and geekin.us.
CORS_ORIGIN=https://geekin.ca

# SMTP credentials for the contact form. Any SMTP provider works
# (your mailbox provider, SendGrid, Postmark, Amazon SES SMTP, etc.).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# "From" address forms are sent as — must usually be a mailbox/domain your
# SMTP provider is authorized to send for.
SMTP_FROM="Geekin Website <no-reply@geekin.ca>"

# Where contact form submissions land.
CONTACT_TO_EMAIL=info@geekin.ca
